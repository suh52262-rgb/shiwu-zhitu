# 统一换行符：仓库内存 LF，检出也保持 LF，避免 Windows 上反复出现
# "LF will be replaced by CRLF" 噪音与虚假 diff。
* text=auto eol=lf

# 二进制资源不做行尾转换
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.sqlite binary

# Hash-pinned evidence must retain original bytes across Git checkouts.
/third_party/** -text
/tests/fixtures/independent/** -text
/examples/public_demo/** -text
/LICENSE -text
/deployment/requirements-windows-py311.lock.txt -text
/requirements-deploy.lock.txt -text
