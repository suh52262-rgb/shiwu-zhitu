# Copy to .env. Keep keys on the recipient's machine only.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
QWEN3VL_MODEL=deepseek/deepseek-flash
EMBEDDING_PROVIDER=bge
# Setup.ps1 replaces this with the package's absolute model path.
EMBEDDING_MODEL=models/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=shiwu
POSTGRES_PASSWORD=shiwu_demo_local
POSTGRES_DB=shiwu_zhitu_demo
POSTGRES_CONNECT_TIMEOUT=3
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=textbook_chunks
BACKEND_URL=http://127.0.0.1:8000
GRAPH_RELEASE_POLICY=legacy-demo
DEPLOY_POSTGRES_PORT=5432
DEPLOY_QDRANT_PORT=6333

# Imported-question Graph roles; original staged workflow remains opt-in.
GRAPH_GENERATOR_MODEL=deepseek-flash
GRAPH_VALIDATOR_MODEL=deepseek-flash
GRAPH_GENERATOR_TIMEOUT=120
RAG_MATERIAL_POLICY=hit_first_total_v1
